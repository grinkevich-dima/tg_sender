# Получить на https://my.telegram.org/apps (раздел API development tools)
TG_API_ID=
TG_API_HASH=

# Пароль на веб-панель (обязательно, если запускаете на сервере)
PANEL_USER=admin
PANEL_PASSWORD=

TZ_NAME=Europe/Minsk

# Если панель открывается по домену (nginx/Caddy) — перечислите его здесь через запятую
# ALLOWED_HOSTS=127.0.0.1,localhost,panel.example.com
