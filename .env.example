# Получить на https://my.telegram.org/apps (раздел API development tools)
TG_API_ID=
TG_API_HASH=

# Пароль базы Postgres в Docker (задайте свой перед первым запуском)
POSTGRES_PASSWORD=
# Без Docker: адрес своей базы Postgres
# DATABASE_URL=postgresql://tg:пароль@127.0.0.1:5432/tg

TZ_NAME=Europe/Minsk

# Если панель открывается по домену (nginx/Caddy) — перечислите его здесь через запятую
# ALLOWED_HOSTS=127.0.0.1,localhost,panel.example.com
# За HTTPS-прокси: cookie входа только по HTTPS
# SECURE_COOKIES=1
# Ключ подписи входа; если не задан — создаётся сам в data/secret_key
# SECRET_KEY=
